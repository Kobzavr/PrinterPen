/* PrinterPen — Light Theme */

QMainWindow, QDialog {
    background-color: #f5f5f7;
    color: #1d1d1f;
}

QWidget {
    background-color: #f5f5f7;
    color: #1d1d1f;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
}

QMenuBar {
    background-color: #ffffff;
    color: #1d1d1f;
    border-bottom: 1px solid #d2d2d7;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #e5e5ea;
    border-radius: 3px;
}

QMenu {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    padding: 4px 0;
}

QMenu::item {
    padding: 5px 24px 5px 26px;
}

QMenu::indicator {
    left: 6px;
    width: 14px;
    height: 14px;
}

QMenu::item:selected {
    background-color: #0066cc;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e5e5ea;
    margin: 4px 0;
}

QPushButton {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #c7c7cc;
    border-radius: 4px;
    padding: 5px 12px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #f0f0f5;
    border-color: #0066cc;
}

QPushButton:pressed {
    background-color: #0066cc;
    color: #ffffff;
}

QPushButton:disabled {
    color: #8e8e93;
    background-color: #f5f5f7;
    border-color: #e5e5ea;
}

QPushButton#btnOpenFonts, QPushButton#btnRefresh {
    padding: 0px 4px;
    min-height: 20px;
    max-height: 26px;
    font-size: 13px;
}

QGroupBox {
    border: 1px solid #d2d2d7;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 6px;
    padding-bottom: 3px;
    color: #6e6e73;
    font-size: 11px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}

QDoubleSpinBox, QSpinBox, QLineEdit, QComboBox {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #c7c7cc;
    border-radius: 3px;
    padding: 2px 5px;
    min-height: 20px;
    selection-background-color: #0066cc;
    selection-color: #ffffff;
}

QDoubleSpinBox:focus, QSpinBox:focus, QLineEdit:focus, QComboBox:focus {
    border-color: #0066cc;
}

QComboBox::drop-down {
    border: none;
    background: #e5e5ea;
    width: 20px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    selection-background-color: #0066cc;
    selection-color: #ffffff;
}

QDockWidget {
    titlebar-close-icon: none;
    color: #1d1d1f;
}

QDockWidget::title {
    background: #ebebed;
    padding: 4px 8px;
    font-weight: bold;
    border-bottom: 1px solid #d2d2d7;
}

QFrame#svgColorRow {
    background: #e8e8ed;
    border: 1px solid #d2d2d7;
    border-radius: 4px;
}

QStatusBar {
    background: #ffffff;
    color: #6e6e73;
    border-top: 1px solid #d2d2d7;
}

QProgressBar {
    background-color: #e5e5ea;
    border: 1px solid #c7c7cc;
    border-radius: 3px;
    text-align: center;
    color: #1d1d1f;
    height: 16px;
}

QProgressBar::chunk {
    background-color: #0066cc;
    border-radius: 2px;
}

QTextEdit {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    font-family: "Consolas", monospace;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c7c7cc;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #8e8e93;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c7c7cc;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #8e8e93;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QAbstractScrollArea::corner {
    background: transparent;
    border: none;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #c7c7cc;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0066cc;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #8e8e93;
    border-radius: 3px;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #0066cc;
    border-color: #0066cc;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* QTabWidget & QTabBar light theme */
QTabWidget::pane {
    border: 1px solid #d2d2d7;
    background-color: #ffffff;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: #ebebed;
    color: #6e6e73;
    border: 1px solid #d2d2d7;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 7px 16px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #f0f0f5;
    color: #1d1d1f;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0066cc;
    border-color: #d2d2d7;
    border-bottom: 2px solid #0066cc;
    font-weight: bold;
}

QPlainTextEdit {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    font-family: "Consolas", monospace;
    border-radius: 3px;
    padding: 4px;
}

QPlainTextEdit:focus {
    border-color: #0066cc;
}

QScrollArea {
    background: transparent;
    border: none;
}
